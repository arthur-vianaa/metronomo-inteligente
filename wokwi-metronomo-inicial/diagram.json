{
  "version": 1,
  "author": "Arthur Viana, Lorenzo Tottola e Mauricio Gomez",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 25, "left": 330, "attrs": {} },
    { "type": "wokwi-microphone", "id": "mic", "top": -125, "left": 35, "attrs": {} },
    {
      "type": "wokwi-potentiometer",
      "id": "potBpm",
      "top": 30,
      "left": 35,
      "attrs": { "value": "512", "label": "BPM 40-200" }
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": 255,
      "left": 35,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnStart",
      "top": -135,
      "left": 610,
      "attrs": { "color": "green", "label": "START / STOP", "key": "S", "bounce": "0" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnModo",
      "top": -135,
      "left": 750,
      "attrs": { "color": "blue", "label": "MODO", "key": "M", "bounce": "0" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btnSimularSom",
      "top": -135,
      "left": 870,
      "attrs": { "color": "yellow", "label": "SIMULAR SOM", "key": "T", "bounce": "0" }
    },
    { "type": "wokwi-resistor", "id": "pullStart", "top": -65, "left": 620, "rotate": 90, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "pullModo", "top": -65, "left": 760, "rotate": 90, "attrs": { "value": "10000" } },
    { "type": "wokwi-resistor", "id": "pullTap", "top": -65, "left": 880, "rotate": 90, "attrs": { "value": "10000" } },
    {
      "type": "wokwi-rgb-led",
      "id": "rgb",
      "top": 180,
      "left": 830,
      "attrs": { "common": "cathode" }
    },
    { "type": "wokwi-resistor", "id": "rLedR", "top": 175, "left": 690, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rLedG", "top": 225, "left": 690, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rLedB", "top": 275, "left": 690, "attrs": { "value": "220" } },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": 360,
      "left": 790,
      "attrs": { "volume": "0.15", "mode": "smooth" }
    }
  ],
  "connections": [
    [ "mic:1", "esp:GND.1", "black", [] ],
    [ "mic:2", "esp:34", "purple", [] ],

    [ "potBpm:VCC", "esp:3V3", "red", [] ],
    [ "potBpm:GND", "esp:GND.1", "black", [] ],
    [ "potBpm:SIG", "esp:35", "orange", [] ],

    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.1", "black", [] ],
    [ "oled:SDA", "esp:21", "green", [] ],
    [ "oled:SCL", "esp:22", "blue", [] ],

    [ "esp:25", "btnStart:1.l", "green", [] ],
    [ "btnStart:2.l", "esp:GND.2", "black", [] ],
    [ "esp:25", "pullStart:1", "green", [] ],
    [ "pullStart:2", "esp:3V3", "red", [] ],

    [ "esp:26", "btnModo:1.l", "blue", [] ],
    [ "btnModo:2.l", "esp:GND.2", "black", [] ],
    [ "esp:26", "pullModo:1", "blue", [] ],
    [ "pullModo:2", "esp:3V3", "red", [] ],

    [ "esp:27", "btnSimularSom:1.l", "orange", [] ],
    [ "btnSimularSom:2.l", "esp:GND.2", "black", [] ],
    [ "esp:27", "pullTap:1", "orange", [] ],
    [ "pullTap:2", "esp:3V3", "red", [] ],

    [ "esp:14", "rLedR:1", "red", [] ],
    [ "rLedR:2", "rgb:R", "red", [] ],
    [ "esp:12", "rLedG:1", "green", [] ],
    [ "rLedG:2", "rgb:G", "green", [] ],
    [ "esp:13", "rLedB:1", "blue", [] ],
    [ "rLedB:2", "rgb:B", "blue", [] ],
    [ "rgb:COM", "esp:GND.3", "black", [] ],

    [ "esp:23", "buzzer:2", "magenta", [] ],
    [ "buzzer:1", "esp:GND.3", "black", [] ]
  ],
  "serialMonitor": {
    "display": "always",
    "newline": "lf"
  },
  "dependencies": {}
}
